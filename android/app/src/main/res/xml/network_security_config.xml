<?xml version="1.0" encoding="utf-8"?>
<!--
    TLS everywhere, without exception. This is the file a release build ships. A debug build
    replaces it (src/debug/res/xml) with one that also allows this device's own loopback.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
