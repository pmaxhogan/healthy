{
  "name": "healthy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal Epic MyChart to Google Calendar sync with a read-only MCP",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "vite build",
    "typecheck": "npm run types && tsc -p tsconfig.worker.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json && vue-tsc -p tsconfig.app.json",
    "types": "wrangler types",
    "prelint": "npm run types",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:spa": "vitest run --project spa",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run knip && npm run test && npm run build",
    "fix": "npm run lint:fix && npm run format",
    "migrate:local": "wrangler d1 migrations apply healthy --local",
    "migrate:remote": "wrangler d1 migrations apply healthy --remote",
    "deploy": "npm run migrate:remote && wrangler deploy",
    "brands:update": "node scripts/slim-brands.mjs",
    "set-password": "tsx scripts/set-password.ts",
    "gen-data-key": "tsx scripts/gen-data-key.ts",
    "set-provider-secret": "tsx scripts/set-provider-secret.ts",
    "set-portal-credentials": "tsx scripts/set-portal-credentials.ts",
    "record-fixtures": "tsx scripts/record-fixtures.ts",
    "prepare": "lefthook install && wrangler types"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "agents": "0.24.0",
    "hono": "^4.13.8",
    "jose": "^6.2.12",
    "postal-mime": "^3.0.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@types/fhir": "^0.0.44",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-unicorn": "^76.0.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "knip": "^6.37.0",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.136.1"
  }
}
