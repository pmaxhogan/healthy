{
  "name": "healthy",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo root: the Cloudflare Worker lives in worker/. Every script here fans into it.",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "worker"
  ],
  "scripts": {
    "dev": "npm run dev -w worker --",
    "dev:worker": "npm run dev:worker -w worker --",
    "build": "npm run build -w worker",
    "typecheck": "npm run typecheck -w worker",
    "knip": "npm run knip -w worker",
    "lint": "npm run format:check && npm run lint -w worker",
    "lint:fix": "npm run lint:fix -w worker",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w worker --",
    "test:unit": "npm run test:unit -w worker --",
    "test:integration": "npm run test:integration -w worker --",
    "test:spa": "npm run test:spa -w worker --",
    "test:watch": "npm run test:watch -w worker --",
    "check": "npm run format:check && npm run check -w worker",
    "fix": "npm run fix -w worker && npm run format",
    "migrate:local": "npm run migrate:local -w worker",
    "migrate:remote": "npm run migrate:remote -w worker",
    "deploy": "npm run deploy -w worker",
    "brands:update": "npm run brands:update -w worker --",
    "set-password": "npm run set-password -w worker --",
    "gen-data-key": "npm run gen-data-key -w worker --",
    "set-health-system-secret": "npm run set-health-system-secret -w worker --",
    "epic-org-secret": "npm run epic-org-secret -w worker --",
    "set-portal-credentials": "npm run set-portal-credentials -w worker --",
    "record-fixtures": "npm run record-fixtures -w worker --",
    "prepare": "lefthook install && npm run types:generate -w worker"
  },
  "devDependencies": {
    "lefthook": "^2.2.0",
    "prettier": "^3.9.9"
  }
}
